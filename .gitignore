# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo
coverage/

# Environment files: never commit real values, only .env.example (NFR-04)
.env
.env.*
!.env.example

# Credentials: the service role key and database password are never written to a file
# in this repository (SEC-10)
*service-account*.json
*serviceAccount*.json
*service-role*
*credentials*.json
*.pem
*.p12
*.key

# Supabase CLI working files (see also supabase/.gitignore)
supabase/.temp/
supabase/.branches/

# Vercel CLI
.vercel/

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
