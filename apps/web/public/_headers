# Response headers for Cloudflare Pages (SEC-12). Vite copies this file into the build output
# as is; Pages reads it from there. The app's own tests check it (src/test/hosting.test.ts).
#
# connect-src allows any Supabase project so one build config serves staging and production.
# challenges.cloudflare.com is Turnstile (SEC-06). Fonts come from Google Fonts.
# api.pwnedpasswords.com is the leaked-password check on new passwords (SEC-05).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.pwnedpasswords.com; frame-src https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# File names under /assets carry a content hash, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
