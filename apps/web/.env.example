# Copy to .env.local for local development (never commit it). For staging and production
# these are set in Cloudflare Pages > Settings > Variables and Secrets, as plain text.
#
# Local: start the stack with `npx supabase start`, then run `npm run env:local` from the
# repo root. It writes .env.local with the local URL and anon key for you.
#
# Both values are public by design (SRS 6.3): access is enforced by Row Level Security and
# server functions. NEVER put the service role key or the database password here; the app
# refuses to start if it finds a server key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (SEC-06). Public. Required for every non-dev build; the dev
# server falls back to Cloudflare's always-pass test key.
VITE_TURNSTILE_SITE_KEY=

# Shown on the sign-in screen before anyone is signed in. Public text only.
VITE_STORE_NAME=
VITE_STORE_ADDRESS=
