# Copy to .env.staging / .env.production (never commit those) and fill in from
# Firebase console > Project settings > Your apps > Web app.
# The dev server (npm run dev) needs none of these: it uses the Emulator Suite.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check reCAPTCHA Enterprise site key (SEC-06). Required for every non-dev build.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Shown on the sign-in screen before anyone is signed in. Public text only.
VITE_STORE_NAME=
VITE_STORE_ADDRESS=

# Dev server only. Set to false to run the dev server against a real project.
# VITE_USE_EMULATORS=false
# Dev server only. An App Check debug token registered in the Firebase console.
# VITE_APPCHECK_DEBUG_TOKEN=
