{
  "name": "pos",
  "version": "0.1.0",
  "private": true,
  "description": "POS + inventory + attendance + lightweight payroll for a single retail store",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck -w apps/web && tsc -p tsconfig.tools.json && npm run typecheck:functions",
    "typecheck:functions": "deno check --config supabase/functions/admin-users/deno.json supabase/functions/admin-users",
    "test": "npm run test -w apps/web",
    "test:db": "supabase test db",
    "test:functions": "node scripts/test-functions.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "env:local": "node scripts/write-local-env.mjs",
    "bootstrap-owner": "tsx scripts/bootstrap-owner.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supabase": "^2.120.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
